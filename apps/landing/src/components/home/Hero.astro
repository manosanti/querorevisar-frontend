---
import { Image } from 'astro:assets';
import carIcon from '../../assets/brand/icone-carro.png';
import motoIcon from '../../assets/brand/icone-moto.png';
import { APP_URL, FEATURES } from '../../config';
import { signInUrl } from '../../lib/links';
import HeroPhone from './HeroPhone.astro';
import SignupForm from './SignupForm.astro';
---

<section
  id="topo"
  class="mx-auto box-content grid max-w-[1200px] grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-center gap-16 px-6 pt-[72px] pb-[88px]"
>
  <div id="criar-conta" class="flex max-w-[560px] flex-col gap-6">
    <div class="flex flex-wrap gap-2">
      <span class="inline-flex items-center gap-1.5 rounded-20 bg-primary-tint py-1.5 pr-3 pl-1.5 text-[13.5px] font-semibold text-primary-strong">
        <Image
          src={carIcon}
          alt=""
          width={26}
          height={26}
          densities={[1, 2]}
          loading="eager"
          class="size-[26px] rounded-full bg-white object-contain"
        />
        <Image
          src={motoIcon}
          alt=""
          width={26}
          height={26}
          densities={[1, 2]}
          loading="eager"
          class="-ml-2 size-[26px] rounded-full bg-white object-contain shadow-[0_0_0_2px_var(--primary-tint)]"
        />
        Para carro e moto
      </span>
    </div>
    <h1 class="m-0 text-[clamp(40px,5.6vw,68px)] leading-[1.02] font-extrabold tracking-[-0.04em] text-balance">
      Cada troca lembrada no km certo.
    </h1>
    <p class="m-0 max-w-[48ch] text-[clamp(17px,1.6vw,20px)] leading-normal text-pretty text-ink-2">
      Registre o que foi trocado e com quantos km. O QueroRevisar acompanha a quilometragem e avisa quando cada item
      pede atenção, vence ou passa do prazo.
    </p>

    <div class="flex max-w-[460px] flex-col gap-3">
      <SignupForm variant="hero" />
      <div class="flex items-center gap-3 text-[13px] text-subtle">
        <span class="h-px flex-1 bg-divider"></span>ou continue com<span class="h-px flex-1 bg-divider"></span>
      </div>
      <div class:list={['grid gap-2', FEATURES.appleLogin ? 'grid-cols-2' : 'grid-cols-1']}>
        <a
          href={signInUrl(APP_URL, { signup: true, provider: 'google' })}
          class="box-content flex h-[50px] items-center justify-center gap-2.5 rounded-12 border border-border text-[15px] font-semibold text-ink hover:border-ink hover:text-ink"
        >
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path
              class="fill-google-yellow"
              d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"
            ></path>
            <path
              class="fill-google-red"
              d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
            ></path>
            <path
              class="fill-google-green"
              d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"
            ></path>
            <path
              class="fill-google-blue"
              d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"
            ></path>
          </svg>
          Google
        </a>
        {FEATURES.appleLogin && (
          <a
            href={signInUrl(APP_URL, { signup: true, provider: 'apple' })}
            class="box-content flex h-[50px] items-center justify-center gap-2.5 rounded-12 border border-border text-[15px] font-semibold text-ink hover:border-ink hover:text-ink"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" class="fill-ink" aria-hidden="true" focusable="false">
              <path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1zM13.9 4.9c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.1 1.1.1 2.3-.6 3-1.5z" />
            </svg>
            Apple
          </a>
        )}
      </div>
      <div class="text-[13.5px] text-muted">Sem senha. Enviamos um código de 6 dígitos para o seu e-mail.</div>
    </div>
  </div>

  <HeroPhone />
</section>
