---
// E-mail sign-up form. With JavaScript it validates like the prototype and hands the e-mail to the app in the
// URL fragment (src/lib/links.ts). Without JavaScript it still opens the app's sign-up (e-mail not sent).
import { APP_URL } from '../../config';
import { EMAIL_ERROR } from '../../lib/email';
import { signInUrl } from '../../lib/links';

interface Props {
  variant: 'hero' | 'band';
}

const { variant } = Astro.props;
const id = `${variant}-email`;
const action = signInUrl(APP_URL);
---

{variant === 'hero' ? (
  <form class="js-signup flex flex-col gap-3" data-variant="hero" action={action} method="get" novalidate>
    <input type="hidden" name="mode" value="signup" />
    <div class="flex flex-wrap gap-2">
      <input
        id={id}
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="seu@email.com"
        aria-label="Seu e-mail"
        class="js-email box-content h-[54px] min-w-0 flex-[1_1_220px] rounded-12 border border-border bg-white px-4 text-base text-ink outline-none placeholder:text-subtle focus:border-primary focus:shadow-[0_0_0_1px_var(--primary)] aria-invalid:border-over-fg aria-invalid:focus:shadow-[0_0_0_1px_var(--over-fg)]"
      />
      <button
        type="submit"
        class="press h-[54px] flex-none rounded-12 bg-primary px-[22px] text-base font-semibold text-white shadow-cta hover:bg-primary-strong"
      >
        Criar conta grátis
      </button>
    </div>
    <div id={`${id}-error`} class="js-email-error text-sm text-over-fg" role="alert" hidden>
      {EMAIL_ERROR}
    </div>
  </form>
) : (
  <form class="js-signup relative flex flex-col gap-2.5" data-variant="band" action={action} method="get" novalidate>
    <input type="hidden" name="mode" value="signup" />
    <div class="flex flex-wrap gap-2 rounded-16 bg-white p-1.5">
      <input
        id={id}
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="seu@email.com"
        aria-label="Seu e-mail"
        class="js-email box-content h-[52px] min-w-0 flex-[1_1_200px] rounded-10 border-0 bg-white px-3.5 text-base text-ink placeholder:text-subtle"
      />
      <button
        type="submit"
        class="press h-[52px] flex-none rounded-[11px] bg-ink px-[22px] text-base font-semibold text-white hover:bg-ink/85"
      >
        Criar conta grátis
      </button>
    </div>
    <div class="text-sm text-white">Sem senha e sem cartão de crédito.</div>
  </form>
)}

<script>
  import { APP_URL } from '../../config';
  import { isValidEmail } from '../../lib/email';
  import { signInUrl } from '../../lib/links';

  const forms = [...document.querySelectorAll<HTMLFormElement>('form.js-signup')];
  const inputs = forms.map(f => f.querySelector<HTMLInputElement>('input.js-email')).filter(i => i !== null);
  const hero = forms.find(f => f.dataset.variant === 'hero');
  const heroInput = hero?.querySelector<HTMLInputElement>('input.js-email') ?? null;
  const heroError = hero?.querySelector<HTMLElement>('.js-email-error') ?? null;

  function setError(on: boolean): void {
    if (!heroInput || !heroError) return;
    heroError.hidden = !on;
    if (on) {
      heroInput.setAttribute('aria-invalid', 'true');
      heroInput.setAttribute('aria-describedby', heroError.id);
    } else {
      heroInput.removeAttribute('aria-invalid');
      heroInput.removeAttribute('aria-describedby');
    }
  }

  // Both forms share the same e-mail, as in the prototype.
  for (const input of inputs) {
    input.addEventListener('input', () => {
      for (const other of inputs) if (other !== input) other.value = input.value;
      setError(false);
    });
  }

  for (const form of forms) {
    form.addEventListener('submit', event => {
      event.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input.js-email')?.value ?? '';
      if (isValidEmail(email)) {
        setError(false);
        window.location.assign(signInUrl(APP_URL, { signup: true, email }));
        return;
      }
      setError(true);
      if (form !== hero && heroInput) {
        // The prototype shows the error next to the hero form and scrolls back up.
        const smooth = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
        window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
        heroInput.focus({ preventScroll: true });
      } else {
        heroInput?.focus();
      }
    });
  }
</script>
