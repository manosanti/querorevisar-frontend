# apps/api — variáveis de ambiente
# Copie para o ambiente local e para os secrets do Cloud Run. Valores <SEM_TOKEN> ativam o modo mock da integração.

SPRING_PROFILES_ACTIVE=local            # local | dev | prod
PORT=8080
APP_URL=http://localhost:5173           # prod: https://app.querorevisar.<PREENCHER>
API_URL=http://localhost:8080           # prod: URL do Cloud Run ou api.querorevisar.<PREENCHER>
WEB_ORIGINS=http://localhost:5173       # lista separada por vírgula
TZ=America/Sao_Paulo

# Banco (Supabase)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres      # dev/prod: pooler transaction mode
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=5

# Auth (Supabase)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=<SEM_TOKEN>          # só se usar chave legada HS256
SUPABASE_SERVICE_ROLE_KEY=<SEM_TOKEN>

# Jobs internos
INTERNAL_JOBS_AUDIENCE=<PREENCHER>        # URL do serviço Cloud Run (OIDC do Scheduler)
INTERNAL_TOKEN=<SEM_TOKEN>                # só local/dev: header X-Internal-Token

# Mercado Pago
PAYMENTS_MODE=mock                        # mock | sandbox | live
MP_ACCESS_TOKEN=<SEM_TOKEN>
MP_WEBHOOK_SECRET=<SEM_TOKEN>
MP_PREMIUM_PLAN_ID=<PREENCHER>
MP_PREMIUM_PRICE_CENTS=1490
MP_BACK_URL_SUCCESS=${APP_URL}/conta?pagamento=ok
MP_BACK_URL_PENDING=${APP_URL}/conta?pagamento=pendente
MP_BACK_URL_FAILURE=${APP_URL}/conta?pagamento=erro
MP_NOTIFICATION_URL=${API_URL}/webhooks/mercadopago
MP_PIX_EXPIRATION_MINUTES=30

# Créditos
CREDIT_UNIT_PRICE_CENTS=490
PREMIUM_MONTHLY_CREDITS=2

# FIPE
FIPE_MODE=live                            # mock | live
FIPE_BASE_URL=https://fipe.parallelum.com.br/api/v2
FIPE_API_TOKEN=<SEM_TOKEN>                # opcional
FIPE_CACHE_DAYS=7
FIPE_DAILY_BUDGET=450                     # teto de chamadas/dia para não estourar o limite

# Consulta veicular
VEHICLE_DATA_MODE=mock                    # mock | live
VEHICLE_DATA_PROVIDER=<PREENCHER>
VEHICLE_DATA_BASE_URL=<PREENCHER>
VEHICLE_DATA_API_KEY=<SEM_TOKEN>

# Push
PUSH_MODE=log                             # log | live
VAPID_PUBLIC_KEY=<PREENCHER>
VAPID_PRIVATE_KEY=<SEM_TOKEN>
VAPID_SUBJECT=mailto:<PREENCHER>

# E-mail
EMAIL_MODE=log                            # log | live
RESEND_API_KEY=<SEM_TOKEN>
EMAIL_FROM=QueroRevisar <alertas@<PREENCHER>>

# Observabilidade e flags
SENTRY_DSN=<SEM_TOKEN>
POSTHOG_KEY=<SEM_TOKEN>
POSTHOG_HOST=https://us.i.posthog.com
