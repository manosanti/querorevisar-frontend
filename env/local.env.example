# .env.local na raiz do repositório — chaves do dono para o `pnpm dev:all` (o arquivo real é ignorado pelo git).
# Copie para ../.env.local e preencha. Linha vazia ou com <SEM_TOKEN>/<PREENCHER> = integração em modo mock.
# Variáveis da API (env/api.env.example) vão para a API como estão; VITE_* vão para a web.
# `pnpm dev:all --embedded` ignora este arquivo (tudo em mock, como no e2e).

# ── Supabase · projeto qr-dev ─────────────────────────────────────────────
# Botão "Connect" no topo do projeto, ou Project Settings → API Keys / Data API.
# URL + chave publicável ligam o login real do Supabase (anônimo, e-mail e senha, Google).
SUPABASE_URL=<PREENCHER>                  # https://<ref>.supabase.co
SUPABASE_ANON_KEY=<SEM_TOKEN>             # Publishable key (sb_publishable_...) ou a "anon" legada
SUPABASE_SERVICE_ROLE_KEY=<SEM_TOKEN>     # Secret key (sb_secret_...): só a API usa, para excluir a conta no Auth
SUPABASE_JWT_SECRET=<SEM_TOKEN>           # só se o projeto ainda assina tokens com o JWT secret legado

# Opcional: sem as duas abaixo, os dados ficam no Postgres embutido (:54322) e só o login é remoto.
# Connect → Connection String; troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=<SEM_TOKEN>                  # "Transaction pooler" (porta 6543)
DATABASE_DIRECT_URL=<SEM_TOKEN>           # "Session pooler" (porta 5432)
